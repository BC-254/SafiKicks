# ================================================================
# Shoe Repair Job Tracking System — Root Environment Variables
# Copy this file to .env before starting Docker Compose or bare metal.
# NEVER commit .env to version control.
# ================================================================

# --- Environment ---
NODE_ENV=production

# --- PostgreSQL Configuration ---
POSTGRES_DB=kelvin_shoe_repair
POSTGRES_USER=postgres
DB_PASSWORD=replace_with_strong_password_minimum_16_characters
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/kelvin_shoe_repair

# --- Security & Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_crypto_secure_64_character_hex_secret
JWT_EXPIRES_IN=8h
PHONE_SESSION_EXPIRES_IN=10m
BCRYPT_ROUNDS=12
SESSION_INACTIVITY_MINUTES=5

# --- SMS Provider (Africa's Talking / Twilio) ---
SMS_PROVIDER=africastalking
# Set SMS_MODE=live in production; set to 'mock' for local dev
SMS_MODE=mock
AT_API_KEY=your_live_africastalking_api_key
AT_USERNAME=your_live_africastalking_username
# AT_SENDER_ID=SoleCare

# --- Domain & URL Endpoints ---
# Public facing base URL (e.g., https://repair.solecare.co.ke)
APP_BASE_URL=http://localhost
CORS_ORIGIN=http://localhost
SHOP_TIMEZONE=Africa/Nairobi

# --- Storage & File Uploads ---
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
IMAGE_MAX_DIMENSION=1200
IMAGE_QUALITY=80

# --- Business Rules ---
REGISTRATION_EXPIRY_HOURS=48
PRICE_CONFIRMATION_TIMEOUT_HOURS=72
ABANDONED_DAYS=30
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
