# ========================================
# Shoe Repair System — Backend Environment
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=3001

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kelvin_shoe_repair
DB_USER=postgres
DB_PASSWORD=your_db_password_here
# Full connection URL (alternative to above individual vars)
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/kelvin_shoe_repair

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h
# Short-lived token for customer phone verification sessions
PHONE_SESSION_EXPIRES_IN=10m

# --- SMS Provider (Africa's Talking) ---
SMS_PROVIDER=africastalking
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
# Set to 'mock' in development to log SMS to console instead of sending
SMS_MODE=mock

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# Max image dimension after compression (px)
IMAGE_MAX_DIMENSION=1200
IMAGE_QUALITY=80

# --- App Settings ---
# Shop timezone for timestamps
SHOP_TIMEZONE=Africa/Nairobi
# URL base for SMS links sent to customers
APP_BASE_URL=http://localhost:5173

# --- Security ---
# Minutes before inactive session auto-logout on shared devices
SESSION_INACTIVITY_MINUTES=5
# Bcrypt salt rounds
BCRYPT_ROUNDS=12
# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10
PICKUP_CODE_EXPIRY_HOURS=24

# --- Business Rules ---
# Hours before unconfirmed registration expires
REGISTRATION_EXPIRY_HOURS=48
# Hours before unconfirmed price is flagged for follow-up
PRICE_CONFIRMATION_TIMEOUT_HOURS=72
# Days before completed-unpicked job becomes Abandoned
ABANDONED_DAYS=30
# Max OTP verification attempts before lockout
OTP_MAX_ATTEMPTS=3
# Max login attempts before lockout
LOGIN_MAX_ATTEMPTS=5
# Minutes for login lockout
LOGIN_LOCKOUT_MINUTES=5

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
